@echo off
setlocal
set "RGCBM_ROOT=%~dp0.."
cd /d "%RGCBM_ROOT%"
set "PATH=%RGCBM_ROOT%\conda-env;%RGCBM_ROOT%\conda-env\Library\bin;%RGCBM_ROOT%\conda-env\Scripts;%PATH%"
set "HF_HUB_OFFLINE=1"
set "TRANSFORMERS_OFFLINE=1"
set "HF_DATASETS_OFFLINE=1"
set "PIP_NO_INDEX=1"
set "PIP_CONFIG_FILE=NUL"
set "PIP_USER=0"
set "PIP_TARGET="
set "PIP_PREFIX="
set "PYTHONHOME="
set "PYTHONPATH="
set "PYTHONNOUSERSITE=1"
set "JUPYTER_RUNTIME_DIR=%RGCBM_ROOT%\runtime"
set "JUPYTER_CONFIG_DIR=%RGCBM_ROOT%\runtime\jupyter-config"
set "JUPYTER_DATA_DIR=%RGCBM_ROOT%\runtime\jupyter-data"
set "JUPYTER_PATH=%RGCBM_ROOT%\conda-env\share\jupyter"
set "IPYTHONDIR=%RGCBM_ROOT%\runtime\ipython"
set "MPLCONFIGDIR=%RGCBM_ROOT%\runtime\matplotlib"
if not exist "%JUPYTER_RUNTIME_DIR%" mkdir "%JUPYTER_RUNTIME_DIR%"
"%RGCBM_ROOT%\conda-env\python.exe" -m notebook --ServerApp.root_dir="%RGCBM_ROOT%" --ip=127.0.0.1
